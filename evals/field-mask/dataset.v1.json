{
  "schema_version": "field-mask.dataset.v1",
  "description": "Frozen synthetic single-turn cases for Maps Places/Routes field mask generation.",
  "input_contract": {
    "allowed_fields": [
      "request"
    ],
    "max_request_chars": 2000
  },
  "output_contract": {
    "required_fields": [
      "field_mask"
    ],
    "additional_fields": false,
    "field_type": "string_array"
  },
  "cases": [
    {
      "id": "normal-essentials-001",
      "category": "normal",
      "split": "train",
      "input": {
        "request": "Find nurseries near me, return only their name, address, and coordinates."
      },
      "expectation": {
        "required_fields": [
          "places.displayName",
          "places.formattedAddress",
          "places.location"
        ],
        "max_sku": "Pro"
      },
      "rubric_ids": [
        "schema_validity",
        "exact_mask_match",
        "no_over_fetching"
      ]
    },
    {
